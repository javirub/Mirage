{
  "name": "mirage",
  "version": "0.1.0",
  "private": true,
  "description": "Proxy web para Vercel que reescribe el DOM para que enlaces y recursos pasen por el propio proxy.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "check": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "hono": "^4.13.5",
    "parse5": "^8.0.1",
    "undici": "^8.10.1"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.1",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
